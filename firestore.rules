rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // cada pessoa só lê e escreve o próprio perfil e os próprios mixes
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /mixes/{mixId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.nome is string && request.resource.data.nome.size() <= 60
          && request.resource.data.sons is map && request.resource.data.sons.size() <= 30;
      }
    }
    // todo o resto fechado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
